# Environment variables untuk website portfolio.
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# File .env*. TIDAK boleh di-commit ke repository.

# ---------------------------------------------------------------------------
# Endpoint form kontak (opsional tapi disarankan untuk produksi).
#
# Isi dengan URL layanan form pihak ketiga yang mendukung POST JSON,
# misalnya:
#   Formspree  : https://formspree.io/f/xxxxxxx
#   Web3Forms  : https://api.web3forms.com/submit   (kirim access_key di body)
#   Basın / Endpoint milik sendiri
#
# Jika KOSONG, form kontak akan membuka aplikasi email pengunjung (mailto)
# sebagai fallback — dan TIDAK pernah menampilkan notifikasi sukses palsu.
# ---------------------------------------------------------------------------
VITE_CONTACT_ENDPOINT=

# ---------------------------------------------------------------------------
# URL situs produksi (opsional). Dipakai bila Anda menambahkan pembacaan
# env di config SEO Anda.
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://example.com/
